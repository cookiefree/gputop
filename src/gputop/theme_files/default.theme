# gputop Default theme: btop's "Default" theme, in btop's .theme format.
# Every gputop theme uses btop's keys, so btop theme files load unchanged.

# Main background; with theme_background = false the terminal default is used.
theme[main_bg]="#00"
# Main text color
theme[main_fg]="#cc"
# Title color for boxes
theme[title]="#ee"
# Highlight color for keyboard shortcuts
theme[hi_fg]="#b54040"
# Background / text color of selected items
theme[selected_bg]="#6a2f2f"
theme[selected_fg]="#ee"
# Color of inactive/disabled text
theme[inactive_fg]="#40"
# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#60"
# Background color of the percentage meters
theme[meter_bg]="#40"
# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#0de756"
# Box outline colors (gputop: cpu_box = GPU boxes, mem_box = VRAM, net_box = PCIe, proc_box = processes)
theme[cpu_box]="#556d59"
theme[mem_box]="#6c6c4b"
theme[net_box]="#5c588d"
theme[proc_box]="#805252"
# Box divider line and small boxes line color
theme[div_line]="#30"
# Temperature graph colors
theme[temp_start]="#4897d4"
theme[temp_mid]="#5474e8"
theme[temp_end]="#ff40b6"
# CPU graph colors (gputop: GPU util, power, encoder/decoder, memory controller)
theme[cpu_start]="#77ca9b"
theme[cpu_mid]="#cbc06c"
theme[cpu_end]="#dc4c4c"
# Mem/Disk free meter
theme[free_start]="#384f21"
theme[free_mid]="#b5e685"
theme[free_end]="#dcff85"
# Mem/Disk cached meter
theme[cached_start]="#163350"
theme[cached_mid]="#74e6fc"
theme[cached_end]="#26c5ff"
# Mem/Disk available meter
theme[available_start]="#4e3f0e"
theme[available_mid]="#ffd77a"
theme[available_end]="#ffb814"
# Mem/Disk used meter (gputop: VRAM)
theme[used_start]="#592b26"
theme[used_mid]="#d9626d"
theme[used_end]="#ff4769"
# Download graph colors (gputop: PCIe RX)
theme[download_start]="#291f75"
theme[download_mid]="#4f43a3"
theme[download_end]="#b0a9de"
# Upload graph colors (gputop: PCIe TX)
theme[upload_start]="#6e2143"
theme[upload_mid]="#ac2f67"
theme[upload_end]="#ff94c7"
# Process box color gradient for threads, mem and cpu usage (gputop: per-process VRAM and SM%)
theme[process_start]="#80d0a3"
theme[process_mid]="#dcd179"
theme[process_end]="#d45454"
